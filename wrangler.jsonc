{
  "name": "bedrock-business-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "triggers": {
    "crons": ["0 20 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bedrock-monitor",
      "database_id": "TO_BE_CREATED"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "SLACK_WEBHOOK_URL": "",
    "SLACK_CHANNEL_ID": "",
    "ENVIRONMENT": "development"
  }
}
